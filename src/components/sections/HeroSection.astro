---
import { company } from '@/config/company';
---

<section class="relative overflow-hidden">
  <div class="container-page grid min-h-[calc(100vh-5rem)] items-center gap-12 py-20 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <p class="inline-flex rounded-full border border-brand-300/30 bg-brand-500/10 px-4 py-2 text-sm font-medium text-brand-100">
        {company.legalName}
      </p>

      <h1 class="mt-7 max-w-4xl text-5xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl text-balance">
        Building reliable digital solutions for modern businesses.
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-9 text-slate-300">
        {company.description}
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-full bg-brand-500 px-7 py-4 text-sm font-bold text-white shadow-lg shadow-brand-500/25 transition hover:bg-brand-400"
        >
          Start a Project
        </a>
        <a
          href="/services/"
          class="inline-flex items-center justify-center rounded-full border border-white/15 px-7 py-4 text-sm font-bold text-white transition hover:bg-white/10"
        >
          View Services
        </a>
      </div>
    </div>

    <div class="card-glass p-5 shadow-glow">
      <div class="rounded-3xl border border-white/10 bg-slate-900/80 p-6">
        <div class="flex items-center justify-between border-b border-white/10 pb-5">
          <div>
            <p class="text-sm text-slate-400">Studio Capability</p>
            <strong class="mt-1 block text-2xl text-white">Digital Build System</strong>
          </div>
          <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-300">
            Professional
          </span>
        </div>

        <div class="grid gap-4 py-6">
          {['Company Website', 'Business Software', 'Mobile Application', 'Digital Product Support'].map((item) => (
            <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-white/[0.04] p-4">
              <span class="text-sm text-slate-300">{item}</span>
              <span class="text-sm font-semibold text-brand-200">Available</span>
            </div>
          ))}
        </div>

        <div class="rounded-2xl bg-white/[0.04] p-5">
          <p class="text-sm leading-7 text-slate-400">
            PT Lumina Logic Studio helps companies create a stronger digital foundation through structured design, practical technology, and maintainable implementation.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
