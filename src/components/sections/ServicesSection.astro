---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { services } from '@/config/company';
---

<section class="section-padding">
  <div class="container-page">
    <SectionHeader
      eyebrow="Services"
      title="Digital services for professional business growth"
      description="PT Lumina Logic Studio provides focused technology services for companies that need websites, applications, and digital product support."
    />

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <article class="card-glass p-7">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-500/15 text-sm font-bold text-brand-200">
            0{index + 1}
          </span>
          <h3 class="mt-6 text-xl font-bold text-white">{service.title}</h3>
          <p class="mt-4 text-sm leading-7 text-slate-400">{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
