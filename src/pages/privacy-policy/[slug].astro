---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AssetVaultPrivacyPolicy from '@/components/privacy/AssetVaultPrivacyPolicy.astro';
import MathIQPrivacyPolicy from '@/components/privacy/MathIQPrivacyPolicy.astro';
import RecipeVaultPrivacyPolicy from '@/components/privacy/RecipeVaultPrivacyPolicy.astro';
import LuminaRoutinePrivacyPolicy from '@/components/privacy/LuminaRoutinePrivacyPolicy.astro';
import AulaPlanPrivacyPolicy from '@/components/privacy/AulaPlanPrivacyPolicy.astro';
import EquationGridPrivacyPolicy from '@/components/privacy/EquationGridPrivacyPolicy.astro';
import { getPrivacyPolicyBySlug, privacyPolicies } from '@/data/privacy-policies';

export function getStaticPaths() {
  return privacyPolicies.map((policy) => ({
    params: { slug: policy.slug },
    props: { policy }
  }));
}

type Policy = (typeof privacyPolicies)[number];

const { policy } = Astro.props as { policy: Policy };

const isDailyPlanner = policy.slug === 'daily-planner';
const isSimpleHabitTracker = policy.slug === 'simple-habit-tracker';
const isAssetVault = policy.slug === 'asset-vault';
const isRecipeVault = policy.slug === 'recipe-vault';
const isMathIQ = policy.slug === 'mathiq';
const isEquationGrid = policy.slug === 'equation-grid';

const title = `${policy.appName} — Privacy Policy`;
const description = policy.shortDescription;

const coveredFeatures = [
  policy.features.localStorage && 'Local Device Storage',
  policy.features.ads && 'Advertising',
  policy.features.analytics && 'Analytics',
  policy.features.crashReporting && 'Crash Reporting',
  policy.features.inAppPurchases && 'In-App Purchases',
  policy.features.subscriptions && 'Subscriptions',
  policy.features.notifications && 'Notifications',
  policy.features.location && 'Location',
  policy.features.camera && 'Camera',
  policy.features.mediaFiles && 'Media Files',
  policy.features.accountSystem && 'Account System',
  policy.features.cloudSync && 'Cloud Sync'
].filter(Boolean);
---

<BaseLayout title={title} description={description}>
  <main>
    <section class="py-14 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-5xl">
          <a
            href="/privacy-center/"
            class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.06] px-4 py-2 text-sm font-bold text-slate-100 transition hover:bg-white/[0.12]"
          >
            ← Privacy Policy Center
          </a>

          <header class="mt-8 overflow-hidden rounded-[2rem] border border-white/15 bg-white/[0.08] shadow-soft backdrop-blur-xl">
            <div class="border-b border-white/10 px-6 py-8 sm:px-10">
              <p class="text-sm font-bold uppercase tracking-[0.32em] text-cyan-200">Official Privacy Policy</p>
              <h1 class="mt-5 text-4xl font-black tracking-tight text-white sm:text-5xl">
                Privacy Policy for {policy.appName}
              </h1>
              <p class="mt-5 max-w-3xl text-base leading-8 text-slate-300">
                {policy.shortDescription}
              </p>
            </div>

            <div class="grid divide-y divide-white/10 sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4">
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Developer</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.developerName}</p>
              </div>
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Effective Date</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.effectiveDate}</p>
              </div>
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Last Updated</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.lastUpdated}</p>
              </div>
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Country</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.country}</p>
              </div>
            </div>
          </header>

          <div class="mt-8 grid gap-8 lg:grid-cols-[260px_1fr] lg:items-start">
            <aside class="rounded-[1.5rem] border border-white/15 bg-white/[0.06] p-5 backdrop-blur-xl lg:sticky lg:top-24">
              <p class="text-xs font-bold uppercase tracking-[0.24em] text-cyan-200">Document Summary</p>

              <div class="mt-5 space-y-4 text-sm">
                <div>
                  <p class="text-slate-400">Website</p>
                  <a href={policy.companyWebsite} class="mt-1 block break-all font-bold text-white hover:text-cyan-100">
                    {policy.companyWebsite}
                  </a>
                </div>

                <div>
                  <p class="text-slate-400">Contact Email</p>
                  <a href={`mailto:${policy.contactEmail}`} class="mt-1 block break-all font-bold text-white hover:text-cyan-100">
                    {policy.contactEmail}
                  </a>
                </div>
              </div>

              <div class="mt-6 border-t border-white/10 pt-5">
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-cyan-200">Covered Features</p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {coveredFeatures.length > 0 ? (
                    coveredFeatures.map((feature) => (
                      <span class="rounded-full border border-cyan-200/10 bg-cyan-300/10 px-3 py-1 text-xs font-semibold text-cyan-50">
                        {feature}
                      </span>
                    ))
                  ) : (
                    <span class="text-sm text-slate-400">No online data collection features.</span>
                  )}
                </div>
              </div>

              {isMathIQ && (
                <div class="mt-6 border-t border-white/10 pt-5">
                  <p class="text-xs font-bold uppercase tracking-[0.24em] text-cyan-200">Legal Documents</p>
                  <div class="mt-4">
                    <a
                      href="/terms-of-service/mathiq/"
                      class="inline-block rounded-xl border border-white/20 bg-white/[0.05] px-4 py-2 text-sm font-bold text-white transition hover:bg-white/[0.1]"
                    >
                      View Terms of Service
                    </a>
                  </div>
                </div>
              )}
            </aside>

            <article class="rounded-[2rem] border border-white/15 bg-white p-6 text-slate-800 shadow-soft sm:p-10">
              {isMathIQ ? (
                <MathIQPrivacyPolicy />
              ) : isEquationGrid ? (
                <EquationGridPrivacyPolicy />
              ) : isRecipeVault ? (
                <RecipeVaultPrivacyPolicy />
              ) : isAssetVault ? (
                <AssetVaultPrivacyPolicy />
              ) : isDailyPlanner ? (
                <AulaPlanPrivacyPolicy />
              ) : isSimpleHabitTracker ? (
                <LuminaRoutinePrivacyPolicy />
              ) : (
                <div class="privacy-document">
                  <section>
                    <h2>1. Introduction</h2>
                    <p>This Privacy Policy explains how {policy.appName} handles information when users access or use the app.</p>
                  </section>

                  <section>
                    <h2>2. Data Handling</h2>
                    <p>{policy.dataCollectionSummary}</p>
                  </section>

                  <section>
                    <h2>3. Contact Us</h2>
                    <p>If users have questions, concerns, or requests regarding this Privacy Policy, they may contact us:</p>
                    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                      <p><strong>{policy.developerName}</strong></p>
                      <p>Email: <a href={`mailto:${policy.contactEmail}`}>{policy.contactEmail}</a></p>
                      <p>Website: <a href={policy.companyWebsite}>{policy.companyWebsite}</a></p>
                      <p>Country: {policy.country}</p>
                    </div>
                  </section>
                </div>
              )}
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .privacy-document :global(section + section) {
    margin-top: 2rem;
  }

  .privacy-document :global(h2) {
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 900;
    color: #020617;
  }

  .privacy-document :global(p) {
    margin-top: 0.9rem;
    line-height: 1.8;
    color: #475569;
  }

  .privacy-document :global(ol),
  .privacy-document :global(ul) {
    margin-top: 1rem;
    padding-left: 1.4rem;
    color: #475569;
  }

  .privacy-document :global(ol) {
    list-style: decimal;
  }

  .privacy-document :global(ul) {
    list-style: disc;
  }

  .privacy-document :global(li + li) {
    margin-top: 0.45rem;
  }

  .privacy-document :global(a) {
    font-weight: 700;
    color: #0369a1;
  }

</style>
