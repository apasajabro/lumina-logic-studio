---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPrivacyPolicyBySlug, privacyPolicies } from '@/data/privacy-policies';

export function getStaticPaths() {
  return privacyPolicies.map((policy) => ({
    params: { slug: policy.slug },
    props: { policy }
  }));
}

type Policy = (typeof privacyPolicies)[number];

const { policy } = Astro.props as { policy: Policy };

const isDailyPlanner = policy.slug === 'daily-planner';
const isSimpleHabitTracker = policy.slug === 'simple-habit-tracker';
const isAssetVault = policy.slug === 'asset-vault';
const isRecipeVault = policy.slug === 'recipe-vault';
const isMathIQ = policy.slug === 'mathiq';

const title = `${policy.appName} — Privacy Policy`;
const description = policy.shortDescription;

const coveredFeatures = [
  policy.features.localStorage && 'Local Device Storage',
  policy.features.ads && 'Advertising',
  policy.features.analytics && 'Analytics',
  policy.features.crashReporting && 'Crash Reporting',
  policy.features.inAppPurchases && 'In-App Purchases',
  policy.features.subscriptions && 'Subscriptions',
  policy.features.notifications && 'Notifications',
  policy.features.location && 'Location',
  policy.features.camera && 'Camera',
  policy.features.mediaFiles && 'Media Files',
  policy.features.accountSystem && 'Account System',
  policy.features.cloudSync && 'Cloud Sync'
].filter(Boolean);
---

<BaseLayout title={title} description={description}>
  <main>
    <section class="py-14 sm:py-20">
      <div class="container-page">
        <div class="mx-auto max-w-5xl">
          <a
            href="/privacy-center/"
            class="inline-flex items-center rounded-full border border-white/15 bg-white/[0.06] px-4 py-2 text-sm font-bold text-slate-100 transition hover:bg-white/[0.12]"
          >
            ← Privacy Policy Center
          </a>

          <header class="mt-8 overflow-hidden rounded-[2rem] border border-white/15 bg-white/[0.08] shadow-soft backdrop-blur-xl">
            <div class="border-b border-white/10 px-6 py-8 sm:px-10">
              <p class="text-sm font-bold uppercase tracking-[0.32em] text-cyan-200">Official Privacy Policy</p>
              <h1 class="mt-5 text-4xl font-black tracking-tight text-white sm:text-5xl">
                Privacy Policy for {policy.appName}
              </h1>
              <p class="mt-5 max-w-3xl text-base leading-8 text-slate-300">
                {policy.shortDescription}
              </p>
            </div>

            <div class="grid divide-y divide-white/10 sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4">
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Developer</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.developerName}</p>
              </div>
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Effective Date</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.effectiveDate}</p>
              </div>
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Last Updated</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.lastUpdated}</p>
              </div>
              <div class="px-6 py-5 sm:px-8">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-400">Country</p>
                <p class="mt-2 text-sm font-bold text-white">{policy.country}</p>
              </div>
            </div>
          </header>

          <div class="mt-8 grid gap-8 lg:grid-cols-[260px_1fr] lg:items-start">
            <aside class="rounded-[1.5rem] border border-white/15 bg-white/[0.06] p-5 backdrop-blur-xl lg:sticky lg:top-24">
              <p class="text-xs font-bold uppercase tracking-[0.24em] text-cyan-200">Document Summary</p>

              <div class="mt-5 space-y-4 text-sm">
                <div>
                  <p class="text-slate-400">Website</p>
                  <a href={policy.companyWebsite} class="mt-1 block break-all font-bold text-white hover:text-cyan-100">
                    {policy.companyWebsite}
                  </a>
                </div>

                <div>
                  <p class="text-slate-400">Contact Email</p>
                  <a href={`mailto:${policy.contactEmail}`} class="mt-1 block break-all font-bold text-white hover:text-cyan-100">
                    {policy.contactEmail}
                  </a>
                </div>
              </div>

              <div class="mt-6 border-t border-white/10 pt-5">
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-cyan-200">Covered Features</p>

                <div class="mt-4 flex flex-wrap gap-2">
                  {coveredFeatures.length > 0 ? (
                    coveredFeatures.map((feature) => (
                      <span class="rounded-full border border-cyan-200/10 bg-cyan-300/10 px-3 py-1 text-xs font-semibold text-cyan-50">
                        {feature}
                      </span>
                    ))
                  ) : (
                    <span class="text-sm text-slate-400">No online data collection features.</span>
                  )}
                </div>
              </div>

              {isMathIQ && (
                <div class="mt-6 border-t border-white/10 pt-5">
                  <p class="text-xs font-bold uppercase tracking-[0.24em] text-cyan-200">Legal Documents</p>
                  <div class="mt-4">
                    <a
                      href="/terms-of-service/mathiq/"
                      class="inline-block rounded-xl border border-white/20 bg-white/[0.05] px-4 py-2 text-sm font-bold text-white transition hover:bg-white/[0.1]"
                    >
                      View Terms of Service
                    </a>
                  </div>
                </div>
              )}
            </aside>

            <article class="rounded-[2rem] border border-white/15 bg-white p-6 text-slate-800 shadow-soft sm:p-10">
              {isMathIQ ? (
                <div class="privacy-document">
                  <section>
                    <h2>Privacy Policy for MathIQ</h2>
                    <p><strong>Effective Date:</strong> August 2026</p>
                    <p>Lumina Logic ("we", "us", or "our") built the MathIQ app as a Free app. This SERVICE is provided by Lumina Logic at no cost and is intended for use as is.</p>
                    <p>This page is used to inform users regarding our policies with the collection, use, and disclosure of Personal Information.</p>
                  </section>

                  <section>
                    <h2>1. Data Collection and Use</h2>
                    <p>MathIQ is a completely offline application. <strong>We do not collect, store, transmit, or share any personal data.</strong></p>
                    <ul>
                      <li><strong>No Analytics or Tracking:</strong> We do not use any third-party analytics, crash reporting, tracking tools, or advertising SDKs.</li>
                      <li><strong>Local Storage Only:</strong> All game progress, statistics, user profiles, and settings are saved locally on your device's internal storage. This data never leaves your device.</li>
                      <li><strong>No Account Required:</strong> You do not need to create an account or sign in to use this application.</li>
                    </ul>
                  </section>

                  <section>
                    <h2>2. Device Permissions</h2>
                    <p>MathIQ does not request or require any sensitive device permissions (such as camera, microphone, contacts, or location).</p>
                  </section>

                  <section>
                    <h2>3. Children's Privacy</h2>
                    <p>Because the app does not collect, transmit, or share any personal data from any user regardless of age, it is fully compliant with the Children's Online Privacy Protection Act (COPPA) and Google Play's Families Policy. We do not knowingly collect personally identifiable information from anyone, including children.</p>
                  </section>

                  <section>
                    <h2>4. Data Deletion</h2>
                    <p>Because your data is only stored locally on your device, you have full control over it. You can delete all your progress and data at any time by:</p>
                    <ul>
                      <li>Using the "Reset Progress" feature inside the app's Profile screen.</li>
                      <li>Clearing the app's data in your device's system settings.</li>
                      <li>Uninstalling the application.</li>
                    </ul>
                  </section>

                  <section>
                    <h2>5. Changes to This Privacy Policy</h2>
                    <p>We may update our Privacy Policy from time to time. Any changes will be reflected in app updates provided through the Google Play Store.</p>
                  </section>

                  <section>
                    <h2>6. Contact Us</h2>
                    <p>If you have any questions or suggestions about our Privacy Policy, do not hesitate to contact us at support@luminalogic.com.</p>
                  </section>
                </div>
              ) : isRecipeVault ? (
                <div class="privacy-document">
                  <section>
                    <h2>Privacy Policy for Recipe Vault: Recipe Manager</h2>
                    <p><strong>Effective Date:</strong> August 2026</p>
                  </section>

                  <section>
                    <h2>1. Data Collection and Storage</h2>
                    <p>Recipe Vault: Recipe Manager is designed with your privacy in mind. All your recipe data, favorites, and settings are stored strictly locally on your device. We do not collect, transmit, or store your personal data on any external servers.</p>
                  </section>

                  <section>
                    <h2>2. Data Usage and Sharing</h2>
                    <p>Because your data never leaves your device, we do not have access to your recipes or personal information. Consequently, we do not sell, rent, or share any of your data with third parties.</p>
                  </section>

                  <section>
                    <h2>3. Device Permissions</h2>
                    <p>The app may require certain device permissions (such as internet access for downloading external recipe images) solely to provide core functionalities. This happens entirely on your device and no usage telemetry is collected.</p>
                  </section>

                  <section>
                    <h2>4. Contact Us</h2>
                    <p>If you have any questions or concerns about this Privacy Policy, please contact us at:</p>
                    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                      <p><strong>Lumina Logic Studio</strong></p>
                      <p>Email: <a href="mailto:luminalogicstudio@proton.me">luminalogicstudio@proton.me</a></p>
                      <p>Website: <a href="https://luminalogictech.my.id/">https://luminalogictech.my.id/</a></p>
                    </div>
                  </section>
                </div>
              ) : isAssetVault ? (
                <div class="privacy-document">
                  <section>
                    <h2>Privacy Policy for Asset Vault</h2>
                    <p><strong>Effective Date:</strong> August 9, 2026</p>
                    <p>Welcome to Asset Vault. We respect your privacy and are committed to protecting it. This Privacy Policy explains our practices regarding your data when you use our mobile application.</p>
                  </section>

                  <section>
                    <h2>1. Local Data Storage</h2>
                    <p>Asset Vault is designed as an offline-first application. All data you create, including inventory text, quantities, and images, is stored locally on your device's internal storage. We do not transmit, sync, or back up your data to our servers or any third-party cloud services.</p>
                  </section>

                  <section>
                    <h2>2. Information We Do Not Collect</h2>
                    <p>We do not collect, harvest, or transmit any personal information, usage analytics, telemetry, or inventory data. Since we do not operate servers to store your data, we have no access to the items you track.</p>
                  </section>

                  <section>
                    <h2>3. Device Permissions</h2>
                    <p>To provide core functionalities, the app requests the following permissions on your device:</p>
                    <ul>
                      <li><strong>Camera:</strong> Required exclusively to capture photos of your assets or scan barcodes/QR codes locally.</li>
                      <li><strong>Storage/Media:</strong> Required to save captured asset images and to generate or read backup files (e.g., CSV, PDF or database files) directly on your device.</li>
                    </ul>
                  </section>

                  <section>
                    <h2>4. Data Security</h2>
                    <p>Your data's security relies on your device's operating system. We utilize standard local database encryption mechanisms provided by the OS. However, please ensure your device is protected with a PIN, password, or biometrics to prevent unauthorized physical access to your inventory data.</p>
                  </section>

                  <section>
                    <h2>5. Data Retention & Deletion</h2>
                    <p>Your data remains on your device for as long as the application is installed. You retain full control over your data. You can permanently delete all your inventory records at any time by clearing the application data in your device settings or by uninstalling the application.</p>
                  </section>

                  <section>
                    <h2>6. Children's Privacy</h2>
                    <p>Our application does not address anyone under the age of 13. We do not knowingly collect or store personally identifiable information from children under 13.</p>
                  </section>

                  <section>
                    <h2>7. Contact Us</h2>
                    <p>If you have any questions, suggestions, or concerns regarding this Privacy Policy, please contact us at:</p>
                    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                      <p><strong>Lumina Logic Studio</strong></p>
                      <p>Email: <a href="mailto:luminalogicstudio@proton.me">luminalogicstudio@proton.me</a></p>
                      <p>Website: <a href="https://luminalogictech.my.id/">https://luminalogictech.my.id/</a></p>
                    </div>
                  </section>

                  <section>
                    <p class="text-center italic">By using Asset Vault, you acknowledge and agree to this Privacy Policy.</p>
                  </section>
                </div>
              ) : isDailyPlanner ? (
                <div class="privacy-document">
                  <section>
                    <h2>Privacy Policy for Daily Planner</h2>
                    <p><strong>Effective Date:</strong> June 29, 2026</p>
                    <p>Daily Planner is developed and published by Lumina Logic Studio.</p>
                    <p>This Privacy Policy explains how Daily Planner handles user data.</p>
                  </section>

                  <section>
                    <h2>Overview</h2>
                    <p>Daily Planner is an offline daily planning app. The app allows users to create and manage tasks, descriptions, due dates, categories, priorities, and completion status.</p>
                    <p>Daily Planner is designed to work without login, cloud sync, advertising SDKs, analytics SDKs, Firebase, or backend servers.</p>
                  </section>

                  <section>
                    <h2>Data Collection</h2>
                    <p>Daily Planner does not collect personal data from users.</p>
                    <p>The app does not transmit planner data to Lumina Logic Studio or to any third-party server.</p>
                  </section>

                  <section>
                    <h2>Local Data Storage</h2>
                    <p>Planner data created inside the app is stored locally on the user’s device using an offline database.</p>
                    <p>This may include:</p>
                    <ol>
                      <li>Task title</li>
                      <li>Task description</li>
                      <li>Due date</li>
                      <li>Category</li>
                      <li>Priority</li>
                      <li>Completion status</li>
                      <li>Created date</li>
                      <li>Updated date</li>
                    </ol>
                    <p>This information remains on the user’s device.</p>
                  </section>

                  <section>
                    <h2>Data Sharing</h2>
                    <p>Daily Planner does not sell, rent, or share user planner data with third parties.</p>
                  </section>

                  <section>
                    <h2>Login and Account</h2>
                    <p>Daily Planner does not require account registration or login.</p>
                  </section>

                  <section>
                    <h2>Advertising and Analytics</h2>
                    <p>Daily Planner does not use advertising SDKs.</p>
                    <p>Daily Planner does not use analytics SDKs.</p>
                    <p>Daily Planner does not display ads.</p>
                  </section>

                  <section>
                    <h2>Purchases and Payments</h2>
                    <p>Daily Planner does not include in-app purchases, subscriptions, or payment features.</p>
                  </section>

                  <section>
                    <h2>Cloud Sync and Backend Servers</h2>
                    <p>Daily Planner does not use cloud sync or backend servers.</p>
                    <p>Planner data is not uploaded to Lumina Logic Studio.</p>
                  </section>

                  <section>
                    <h2>Permissions</h2>
                    <p>Daily Planner does not request sensitive permissions such as:</p>
                    <ol>
                      <li>Location</li>
                      <li>Camera</li>
                      <li>Microphone</li>
                      <li>Contacts</li>
                      <li>Broad file storage access</li>
                    </ol>
                  </section>

                  <section>
                    <h2>Data Deletion</h2>
                    <p>Users can delete tasks directly inside the app.</p>
                    <p>Users can also remove all local app data by uninstalling the app or clearing the app data from their device settings.</p>
                    <p>Because Daily Planner does not collect or store user data on Lumina Logic Studio servers, there is no server-side account data to delete.</p>
                  </section>

                  <section>
                    <h2>Children’s Privacy</h2>
                    <p>Daily Planner is a general productivity app and does not knowingly collect data from children.</p>
                  </section>

                  <section>
                    <h2>Changes to This Privacy Policy</h2>
                    <p>Lumina Logic Studio may update this Privacy Policy when necessary. Any updates will be posted on this page.</p>
                  </section>

                  <section>
                    <h2>Contact</h2>
                    <p>For privacy questions or support, contact:</p>
                    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                      <p><strong>Lumina Logic Studio</strong></p>
                      <p>Email: <a href="mailto:luminalogicstudio@proton.me">luminalogicstudio@proton.me</a></p>
                      <p>Website: <a href="https://luminalogictech.my.id/">https://luminalogictech.my.id/</a></p>
                    </div>
                  </section>
                </div>
              ) : isSimpleHabitTracker ? (
                <div class="privacy-document">
                  <section>
                    <h2>Privacy Policy for Simple Habit Tracker</h2>
                    <p><strong>Effective Date:</strong> July 1, 2026</p>
                    <p>Simple Habit Tracker is developed and published by Lumina Logic Studio.</p>
                    <p>This Privacy Policy explains how Simple Habit Tracker handles user data.</p>
                  </section>

                  <section>
                    <h2>Overview</h2>
                    <p>Simple Habit Tracker is an offline habit tracking app. The app allows users to create habits, add descriptions, choose categories, set frequency, set daily targets, mark habits as completed for the day, archive habits, restore habits, delete habits, and view simple local progress statistics.</p>
                    <p>Simple Habit Tracker is designed to work without login, cloud sync, advertising SDKs, analytics SDKs, Firebase, or backend servers.</p>
                  </section>

                  <section>
                    <h2>Data Collection</h2>
                    <p>Simple Habit Tracker does not collect personal data from users.</p>
                    <p>The app does not transmit habit data to Lumina Logic Studio or to any third-party server.</p>
                  </section>

                  <section>
                    <h2>Local Data Storage</h2>
                    <p>Habit data created inside the app is stored locally on the user’s device using an offline database.</p>
                    <p>This may include:</p>
                    <ol>
                      <li>Habit name</li>
                      <li>Habit description</li>
                      <li>Habit category</li>
                      <li>Habit frequency</li>
                      <li>Daily target</li>
                      <li>Habit color preference</li>
                      <li>Daily completion progress</li>
                      <li>Archive status</li>
                      <li>Created date</li>
                      <li>Updated date</li>
                    </ol>
                    <p>This information remains on the user’s device.</p>
                  </section>

                  <section>
                    <h2>Data Sharing</h2>
                    <p>Simple Habit Tracker does not sell, rent, trade, or share user habit data with third parties.</p>
                  </section>

                  <section>
                    <h2>Login and Account</h2>
                    <p>Simple Habit Tracker does not require account registration or login.</p>
                  </section>

                  <section>
                    <h2>Advertising and Analytics</h2>
                    <p>Simple Habit Tracker does not use advertising SDKs.</p>
                    <p>Simple Habit Tracker does not use analytics SDKs.</p>
                    <p>Simple Habit Tracker does not display ads.</p>
                  </section>

                  <section>
                    <h2>Purchases and Payments</h2>
                    <p>Simple Habit Tracker does not include in-app purchases, subscriptions, or payment features.</p>
                  </section>

                  <section>
                    <h2>Cloud Sync and Backend Servers</h2>
                    <p>Simple Habit Tracker does not use cloud sync or backend servers.</p>
                    <p>Habit data is not uploaded to Lumina Logic Studio.</p>
                  </section>

                  <section>
                    <h2>Permissions</h2>
                    <p>Simple Habit Tracker does not request sensitive permissions such as:</p>
                    <ol>
                      <li>Location</li>
                      <li>Camera</li>
                      <li>Microphone</li>
                      <li>Contacts</li>
                      <li>Calendar</li>
                      <li>Photos or media library</li>
                      <li>Broad file storage access</li>
                    </ol>
                  </section>

                  <section>
                    <h2>Data Deletion</h2>
                    <p>Users can manage habit data directly inside the app.</p>
                    <p>Users can delete habits directly inside the app. When a habit is deleted, the habit and its local progress records are removed from the app database on the user’s device.</p>
                    <p>Users can also remove local app data by uninstalling the app or clearing the app data from their device settings.</p>
                    <p>Because Simple Habit Tracker does not collect or store user data on Lumina Logic Studio servers, there is no server-side account data to delete.</p>
                  </section>

                  <section>
                    <h2>Children’s Privacy</h2>
                    <p>Simple Habit Tracker is a general productivity and habit tracking app and does not knowingly collect personal data from children.</p>
                  </section>

                  <section>
                    <h2>Changes to This Privacy Policy</h2>
                    <p>Lumina Logic Studio may update this Privacy Policy when necessary. Any updates will be posted on this page.</p>
                  </section>

                  <section>
                    <h2>Contact</h2>
                    <p>For privacy questions or support, contact:</p>
                    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                      <p><strong>Lumina Logic Studio</strong></p>
                      <p>Email: <a href="mailto:luminalogicstudio@proton.me">luminalogicstudio@proton.me</a></p>
                      <p>Website: <a href="https://luminalogictech.my.id/">https://luminalogictech.my.id/</a></p>
                    </div>
                  </section>
                </div>
              ) : (
                <div class="privacy-document">
                  <section>
                    <h2>1. Introduction</h2>
                    <p>This Privacy Policy explains how {policy.appName} handles information when users access or use the app.</p>
                  </section>

                  <section>
                    <h2>2. Data Handling</h2>
                    <p>{policy.dataCollectionSummary}</p>
                  </section>

                  <section>
                    <h2>3. Contact Us</h2>
                    <p>If users have questions, concerns, or requests regarding this Privacy Policy, they may contact us:</p>
                    <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                      <p><strong>{policy.developerName}</strong></p>
                      <p>Email: <a href={`mailto:${policy.contactEmail}`}>{policy.contactEmail}</a></p>
                      <p>Website: <a href={policy.companyWebsite}>{policy.companyWebsite}</a></p>
                      <p>Country: {policy.country}</p>
                    </div>
                  </section>
                </div>
              )}
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .privacy-document :global(section + section) {
    margin-top: 2rem;
  }

  .privacy-document :global(h2) {
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 900;
    color: #020617;
  }

  .privacy-document :global(p) {
    margin-top: 0.9rem;
    line-height: 1.8;
    color: #475569;
  }

  .privacy-document :global(ol),
  .privacy-document :global(ul) {
    margin-top: 1rem;
    padding-left: 1.4rem;
    color: #475569;
  }

  .privacy-document :global(ol) {
    list-style: decimal;
  }

  .privacy-document :global(ul) {
    list-style: disc;
  }

  .privacy-document :global(li + li) {
    margin-top: 0.45rem;
  }

  .privacy-document :global(a) {
    font-weight: 700;
    color: #0369a1;
  }
</style>
